generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OWNER
}

enum QrStatus {
  UNACTIVATED
  ACTIVE
  DISABLED
  ARCHIVED
}

enum EventType {
  SCAN
  REVIEW_CLICK
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role       @default(OWNER)
  businesses   Business[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Business {
  id              String   @id @default(cuid())
  ownerId         String?  // diisi saat pemilik mengklaim akun (OTP/email)
  owner           User?    @relation(fields: [ownerId], references: [id])
  businessName    String
  ownerName       String
  phone           String
  address         String
  description     String?
  logoUrl         String?
  googleMapsUrl   String
  googleReviewUrl String
  qrCode          QrCode?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([ownerId])
}

model QrCode {
  id           String      @id @default(cuid())
  publicToken  String      @unique            // di URL /q/[token]; tidak pernah berubah
  pinHash      String                          // bcrypt dari PIN aktivasi
  pin          String?                         // PIN aktivasi, terlihat admin selama QR belum aktif
  businessId   String?     @unique             // unik: 1 QR = 1 bisnis
  business     Business?   @relation(fields: [businessId], references: [id])
  status       QrStatus    @default(UNACTIVATED)
  failedPinAttempts Int    @default(0)
  activatedAt  DateTime?
  scanEvents   ScanEvent[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([status])
}

model ScanEvent {
  id        String    @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  eventType EventType
  createdAt DateTime  @default(now())   // tanpa IP / data pribadi pelanggan
  @@index([qrCodeId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String   // mis. QR_ACTIVATED, QR_DISABLED, REVIEW_URL_CHANGED
  targetId  String?
  createdAt DateTime @default(now())
  @@index([targetId])
}
