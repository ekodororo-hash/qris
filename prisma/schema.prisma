generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OWNER
}

enum QrStatus {
  UNACTIVATED
  ACTIVE
  DISABLED
  ARCHIVED
}

enum EventType {
  SCAN
  REVIEW_CLICK
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  role         Role       @default(OWNER)
  businesses   Business[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Business {
  id              String   @id @default(cuid())
  ownerId         String?  // diisi saat pemilik mengklaim akun (OTP/email)
  owner           User?    @relation(fields: [ownerId], references: [id])
  businessName    String
  ownerName       String
  phone           String
  address         String
  description     String?
  logoUrl         String?
  googleMapsUrl   String
  googleReviewUrl String
  qrCode          QrCode?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([ownerId])
}

model QrCode {
  id           String      @id @default(cuid())
  publicToken  String      @unique            // di URL /q/[token]; tidak pernah berubah
  pinHash      String                          // legacy: tetap diisi agar skema DB tidak berubah (tidak dipakai admin)
  pin          String?                         // PIN aktivasi (plain, terlihat admin selama QR belum aktif)
  businessId   String?     @unique             // unik: 1 QR = 1 bisnis
  business     Business?   @relation(fields: [businessId], references: [id])
  status       QrStatus    @default(UNACTIVATED)
  failedPinAttempts Int    @default(0)
  activatedAt  DateTime?
  salespersonId String?                        // sales yang memegang QR ini (null = belum diserahkan)
  salesperson  Salesperson? @relation(fields: [salespersonId], references: [id])
  assignedAt   DateTime?                       // kapan diserahkan ke sales
  price        Int?                            // setoran wajib per QR (rupiah), dikunci saat diserahkan
  scanEvents   ScanEvent[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  @@index([status])
  @@index([salespersonId])
}

model ScanEvent {
  id        String    @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  eventType EventType
  createdAt DateTime  @default(now())   // tanpa IP / data pribadi pelanggan
  @@index([qrCodeId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String   // mis. QR_ACTIVATED, QR_DISABLED, REVIEW_URL_CHANGED
  targetId  String?
  createdAt DateTime @default(now())
  @@index([targetId])
}

// Sales: hanya nama yang dikelola admin (tanpa login). QR berstatus aktif milik sales = wajib setor.
model Salesperson {
  id        String    @id @default(cuid())
  name      String
  qrCodes   QrCode[]
  payments  Payment[]
  createdAt DateTime  @default(now())
}

// Catatan setoran dari sales ke admin (rupiah).
model Payment {
  id            String      @id @default(cuid())
  salespersonId String
  salesperson   Salesperson @relation(fields: [salespersonId], references: [id])
  amount        Int
  paidAt        DateTime
  note          String?
  createdAt     DateTime    @default(now())
  @@index([salespersonId, paidAt])
}

// Pengaturan sederhana key-value, mis. QR_PRICE = setoran wajib per QR.
model Setting {
  key   String @id
  value String
}
