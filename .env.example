# Supabase -> tombol "Connect" di dashboard project.
# Runtime (Vercel): Transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrasi: Session pooler, port 5432 (IPv4-compatible)
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# openssl rand -base64 32
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Admin awal (password min. 12 karakter)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
# Pencarian alamat di Google Maps (opsional). Google Cloud -> aktifkan "Places API (New)", buat API key
# (batasi hanya ke Places API, pasang kuota harian). Tanpa ini, alamat tetap bisa diketik manual.
GOOGLE_MAPS_API_KEY=""
